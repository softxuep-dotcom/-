{
  "name": "fling-fiasco",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A portrait-first 3D ragdoll physics comedy game for the web.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src vite.config.ts playwright.config.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert @soak",
    "test:soak": "playwright test tests/e2e/soak.spec.ts --grep @soak",
    "test:all": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "assets": "node tools/generate-assets.mjs",
    "release": "npm run assets && npm run test:all && npm run build && node tools/package-release.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "@types/three": "0.185.1",
    "eslint": "10.8.0",
    "fflate": "^0.8.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
